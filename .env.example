# Database - Neon PostgreSQL
# Add connection pool parameters for Neon free tier auto-suspension:
# - connection_limit: Number of connections in pool (10 for Neon free tier)
# - pool_timeout: Seconds to wait for connection (60s for Neon wake-up)
# - pgbouncer: Enable Neon's connection pooler
DATABASE_URL="postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=60&pgbouncer=true"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# AI Services
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Storage
UPLOAD_DIR="./public/uploads"
PDF_OUTPUT_DIR="./public/pdfs"


# Local Tectonic Path
TECTONIC_PATH="D:\\event_folde\\Event_management\\tectonic.exe"
