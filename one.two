  <!-- ============================================================
       HERO SECTION
       ============================================================ -->
  <div class="hero-outer">
    <div class="hero-container">
      <img
        src="https://sspark.genspark.ai/cfimages?u1=9E%2B68%2FoiVRY7JHL%2BFTaaxUp1LugSPrN1wEfDfWkiNoO2c3M5fRmyypN3ppEB7Qwpx813DezvE5SLjdAsz7%2BsuybRrHoTis7B3JzDi06UCAcQjM3UgJah18LmW7CZghO7%2FEsKEEajZ%2FrwQSh7pKZf3RnzCSwbPCNt19JGTA%3D%3D&width=1400"
        alt="Jain University Campus"
        class="hero-bg-img"
