          Discover workshops, seminars, symposiums and more — all in one place.
        </p>
        <div class="hero-stats-row">
          <div class="hero-stat">
            <span class="hero-stat-num" id="statTotal">—</span>
            <span class="hero-stat-label">Total Events</span>
          </div>
          <div class="hero-stat-sep"></div>
          <div class="hero-stat">
            <span class="hero-stat-num gold" id="statUpcoming">—</span>
            <span class="hero-stat-label">Upcoming</span>
          </div>
          <div class="hero-stat-sep"></div>
          <div class="hero-stat">
            <span class="hero-stat-num" id="statToday">—</span>
            <span class="hero-stat-label">Today</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       PAGE BODY
       ============================================================ -->
  <div class="page-body">

    <!-- ── FILTER BAR ── -->
    <div class="filter-bar-wrapper">
      <div class="filter-bar-card">
        <!-- Search -->
        <div class="filter-search-wrap">
          <i class="fas fa-search filter-search-icon"></i>
          <input
            type="text"
            id="searchInput"
            class="filter-search"
            placeholder="Search events, locations, organizers…"
          />
        </div>

        <div class="filter-divider"></div>

        <!-- Department dropdown -->
        <div class="filter-select-wrap">
          <i class="fas fa-building filter-select-icon"></i>
          <select id="departmentSelect" class="filter-select">
            <option value="all">All Departments</option>
            <option value="computer-science">Computer Science</option>
            <option value="mathematics">Mathematics</option>
            <option value="physics">Physics</option>
            <option value="chemistry">Chemistry</option>
            <option value="biology">Biology</option>
            <option value="english">English</option>
            <option value="history">History</option>
          </select>
          <i class="fas fa-chevron-down filter-select-arrow"></i>
        </div>

        <div class="filter-divider"></div>

        <!-- Timeline pills -->
        <div class="timeline-pills" id="timelineFilter">
          <button class="tl-pill active" data-timeline="all">All</button>
          <button class="tl-pill" data-timeline="future">Upcoming</button>
          <button class="tl-pill" data-timeline="present">Today</button>
          <button class="tl-pill" data-timeline="past">Past</button>
        </div>

        <div style="flex:1;"></div>

        <!-- View toggle -->
        <div class="view-toggle">
          <button class="vt-btn active" data-view="grid" id="gridViewBtn" title="Grid View">
            <i class="fas fa-th-large"></i>
          </button>
          <button class="vt-btn" data-view="list" id="listViewBtn" title="List View">
            <i class="fas fa-list"></i>
          </button>
          <button class="vt-btn" data-view="calendar" id="calViewBtn" title="Calendar View">
            <i class="fas fa-calendar-alt"></i>
          </button>
        </div>

        <!-- Export -->
        <button class="export-btn" id="exportBtn">
          <i class="fas fa-download"></i>
          Export CSV
        </button>
      </div>
    </div>

    <!-- Results count -->
    <div class="results-bar">
      <span class="results-count"><strong id="resultsCount">0</strong> events found</span>
    </div>

    <!-- ── CONTENT LAYOUT ── -->
    <div class="content-layout">

      <!-- Events Column -->
      <div class="events-column">

        <!-- GRID VIEW -->
        <section id="eventsGridSection">
          <div class="events-grid" id="eventsGrid"></div>
          <div class="empty-state" id="emptyState">
            <div class="empty-icon"><i class="fas fa-calendar-times"></i></div>
            <h3 style="font-size:18px;color:var(--text-mid);font-weight:700;">No events found</h3>
            <p style="font-size:14px;color:var(--text-soft);">Try adjusting your filters or search, or add a new event.</p>
            <button
              class="add-event-btn"
              style="margin-top:8px;"
              onclick="document.getElementById('addEventBtn').click()"
            >
              <i class="fas fa-plus"></i> Add New Event
            </button>
          </div>
        </section>

        <!-- CALENDAR (full page) VIEW -->
        <section class="calendar-section" id="calendarFullSection">
          <div class="big-calendar-wrap">
            <div class="big-cal-header">
              <button class="cal-nav-btn" id="prevMonthBig" title="Previous Month">
                <i class="fas fa-chevron-left"></i>
              </button>
              <span class="big-cal-month" id="bigCalMonthTitle">March 2026</span>
              <button class="cal-nav-btn" id="nextMonthBig" title="Next Month">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
            <div class="big-cal-body-panel">
              <div class="big-cal-main">
                <div class="big-cal-body">
                  <div class="big-cal-day-headers" id="bigCalDayHeaders"></div>
                  <div class="big-cal-grid" id="bigCalGrid"></div>
                </div>
              </div>
              <div class="big-cal-side-panel" id="bigCalSidePanel">
                <div class="big-cal-side-inner">
                  <div class="big-cal-side-header">
                    <span class="big-cal-side-title" id="bigCalSideTitle">Events</span>
                    <button class="big-cal-side-close" id="bigCalSideClose">
                      <i class="fas fa-times"></i>
                    </button>
                  </div>
                  <div class="big-cal-side-events" id="bigCalSideEvents"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Calendar Panel (right column, hidden in calendar view) -->
      <aside class="calendar-column" id="calendarSidePanelCol">
        <div class="cal-panel-card">
          <div class="cal-panel-header">
            <button class="cal-nav-btn" id="prevMonth" title="Previous Month">
              <i class="fas fa-chevron-left"></i>
            </button>
            <span class="cal-month-title" id="currentMonth">March 2026</span>
            <button class="cal-nav-btn" id="nextMonth" title="Next Month">
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
          <div class="cal-grid-container">
            <div class="cal-day-headers" id="calDayHeaders"></div>
            <div class="cal-days-grid" id="calDaysGrid"></div>
          </div>
          <!-- Day events panel -->
          <div class="cal-day-panel" id="calDayPanel">
            <div class="cal-day-panel-inner">
              <div class="cal-day-panel-header">
                <span class="cal-day-panel-title" id="calDayPanelTitle">Events</span>
                <button class="cal-day-panel-close" id="calDayPanelClose">
                  <i class="fas fa-times"></i>
                </button>
              </div>
              <div class="cal-day-events-list" id="calDayEventsList"></div>
            </div>
          </div>
        </div>
      </aside>

    </div><!-- /.content-layout -->
  </div><!-- /.page-body -->

  <!-- ============================================================
       DETAIL MODAL (slide up from bottom)
       ============================================================ -->
  <div class="detail-modal-backdrop" id="detailModalBackdrop">
    <div class="detail-modal-sheet">
      <div class="detail-drag-handle"></div>
      <button class="detail-close-btn" id="detailCloseBtn">
        <i class="fas fa-times"></i>
      </button>
      <span class="detail-badge" id="detailBadge">Upcoming</span>
      <h2 class="detail-title" id="detailTitle">Event Name</h2>
      <div class="detail-dept-label" id="detailDept">Department</div>

      <div class="detail-meta-grid">
        <div class="dm">
          <i class="fas fa-calendar-day dm-icon"></i>
          <div>
            <div class="dm-label">Date</div>
            <div class="dm-value" id="detailDate">—</div>
          </div>
        </div>
        <div class="dm">
          <i class="fas fa-clock dm-icon"></i>
          <div>
            <div class="dm-label">Time</div>
            <div class="dm-value" id="detailTime">—</div>
          </div>
        </div>
        <div class="dm">
          <i class="fas fa-map-marker-alt dm-icon"></i>
          <div>
            <div class="dm-label">Venue</div>
            <div class="dm-value" id="detailVenue">—</div>
          </div>
        </div>
        <div class="dm">
          <i class="fas fa-user-tie dm-icon"></i>
          <div>
            <div class="dm-label">Organizer</div>
            <div class="dm-value" id="detailOrganizer">—</div>
          </div>
        </div>
        <div class="dm">
          <i class="fas fa-users dm-icon"></i>
          <div>
            <div class="dm-label">Capacity</div>
            <div class="dm-value" id="detailCapacity">—</div>
          </div>
        </div>
      </div>

      <div class="detail-desc-label">
        <i class="fas fa-align-left"></i>
        About this Event
      </div>
      <p class="detail-desc-text" id="detailDesc">—</p>

      <div class="detail-actions">
        <button class="detail-primary-btn" id="detailSpotlightBtn">
          <i class="fas fa-layer-group"></i>
          View Full Details
        </button>
        <button class="detail-edit-btn-sm" id="detailEditBtn">
          <i class="fas fa-pen"></i>
          Edit Event
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ADD / EDIT EVENT MODAL
       ============================================================ -->
  <div class="form-modal-backdrop" id="formModalBackdrop">
    <div class="form-modal-box">
      <div class="form-modal-header">
        <div class="form-modal-title-group">
          <div class="form-modal-icon">
            <i class="fas fa-calendar-plus"></i>
          </div>
          <span class="form-modal-title" id="formModalTitle">Add New Event</span>
        </div>
        <button class="form-modal-close" id="formModalClose">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <form id="eventForm" class="form-modal-body">
        <input type="hidden" id="eventId" />

        <div class="form-field">
          <label class="form-label">Event Name <span class="form-req">*</span></label>
          <input type="text" id="eventName" class="form-input" required placeholder="Enter event name" />
        </div>

        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Department <span class="form-req">*</span></label>
            <div class="select-field-wrap">
              <select id="eventDepartment" class="form-select" required>
                <option value="">Select Department</option>
                <option value="computer-science">Computer Science</option>
                <option value="mathematics">Mathematics</option>
                <option value="physics">Physics</option>
                <option value="chemistry">Chemistry</option>
                <option value="biology">Biology</option>
                <option value="english">English</option>
                <option value="history">History</option>
              </select>
              <i class="fas fa-chevron-down select-field-arrow"></i>
            </div>
          </div>
          <div class="form-field">
            <label class="form-label">Date <span class="form-req">*</span></label>
            <input type="date" id="eventDate" class="form-input" required />
          </div>
          <div class="form-field">
            <label class="form-label">Time <span class="form-req">*</span></label>
            <input type="time" id="eventTime" class="form-input" required />
          </div>
        </div>

        <div class="form-field">
          <label class="form-label">Venue / Location <span class="form-req">*</span></label>
          <input type="text" id="eventLocation" class="form-input" required placeholder="Room, building, or address" />
        </div>

        <div class="form-field">
          <label class="form-label">Description</label>
          <textarea id="eventDescription" class="form-textarea" rows="3" placeholder="Brief description of the event…"></textarea>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label class="form-label">Capacity</label>
            <input type="number" id="eventCapacity" class="form-input" placeholder="Max seats (e.g. 50)" min="1" />
          </div>
          <div class="form-field">
            <label class="form-label">Organizer</label>
            <input type="text" id="eventOrganizer" class="form-input" placeholder="Faculty / coordinator name" />
          </div>
        </div>
      </form>

      <div class="form-modal-footer">
        <button type="button" class="btn-ghost-form" id="formCancelBtn">Cancel</button>
        <button type="submit" form="eventForm" class="btn-primary-form">
          <i class="fas fa-check"></i>
          Save Event
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       TOAST NOTIFICATION
       ============================================================ -->
  <div class="toast-notification" id="toastNotification">
    <i class="fas fa-check-circle toast-icon"></i>
    <span id="toastMessage">Done</span>
  </div>

  <!-- ============================================================
       JAVASCRIPT
       ============================================================ -->
  <script>
    /* ================================================================
       STATE
       ================================================================ */
    const state = {
      events: [],
      filteredEvents: [],
      selectedDepartment: 'all',
      selectedTimeline: 'all',
      searchQuery: '',
      currentView: 'grid',       // 'grid' | 'list' | 'calendar'
      currentMonth: new Date(),
      editingEventId: null,
      openDetailId: null,
    };

    /* ================================================================
       SAMPLE DATA
       ================================================================ */
    const sampleEvents = [
      { id: '1',  name: 'AI & Machine Learning Workshop',      department: 'computer-science', date: '2024-12-20', time: '14:00', location: 'CS Lab 301',                         description: 'Learn the fundamentals of AI and Machine Learning with hands-on examples. Topics include neural networks, deep learning, and practical applications.', capacity: 50,  organizer: 'Dr. Sarah Johnson',   color: '#6366f1', poster: 'posters/event1.jpg'  },
      { id: '2',  name: 'Calculus Study Session',              department: 'mathematics',      date: '2024-12-25', time: '10:00', location: 'Math Building Room 205',              description: 'Comprehensive review session covering derivatives, integrals, and applications. Bring your questions!',                                                     capacity: 30,  organizer: 'Prof. Michael Chen',  color: '#8b5cf6', poster: 'posters/event2.jpg'  },
      { id: '3',  name: 'Quantum Physics Lecture',             department: 'physics',          date: '2024-12-18', time: '15:30', location: 'Physics Auditorium',                  description: 'Explore the fascinating world of quantum mechanics, wave-particle duality, and quantum computing.',                                                         capacity: 100, organizer: 'Dr. Emily Watson',    color: '#ec4899', poster: 'posters/event3.jpg'  },
      { id: '4',  name: 'Organic Chemistry Lab',               department: 'chemistry',        date: '2024-12-28', time: '13:00', location: 'Chemistry Lab B',                     description: 'Hands-on laboratory session focusing on organic synthesis and reaction mechanisms.',                                                                         capacity: 25,  organizer: 'Dr. Robert Lee',      color: '#f59e0b', poster: 'posters/event4.jpg'  },
      { id: '5',  name: 'Cell Biology Seminar',                department: 'biology',          date: '2024-12-22', time: '11:00', location: 'Biology Hall 102',                    description: 'Latest research in cellular processes, genetics, and biotechnology applications.',                                                                          capacity: 40,  organizer: 'Dr. Lisa Anderson',   color: '#10b981', poster: 'posters/event5.jpg'  },
      { id: '6',  name: 'Shakespeare Reading Group',           department: 'english',          date: '2025-01-05', time: '16:00', location: 'Library Reading Room',               description: 'Discussion and analysis of Hamlet with focus on literary themes and character development.',                                                                  capacity: 20,  organizer: 'Prof. James Wilson',  color: '#3b82f6', poster: 'posters/event6.jpg'  },
      { id: '7',  name: 'World War II History Discussion',     department: 'history',          date: '2025-01-08', time: '14:30', location: 'History Department Room 401',         description: 'Examining the causes, events, and aftermath of World War II with primary source analysis.',                                                                 capacity: 35,  organizer: 'Dr. Patricia Brown',  color: '#ef4444', poster: 'posters/event7.jpg'  },
      { id: '8',  name: 'Web Development Bootcamp',            department: 'computer-science', date: '2025-01-10', time: '09:00', location: 'Computer Lab A',                      description: 'Intensive full-day workshop on HTML, CSS, JavaScript, and modern web frameworks.',                                                                           capacity: 30,  organizer: 'Dr. Sarah Johnson',   color: '#6366f1', poster: 'posters/event8.jpg'  },
      { id: '9',  name: 'Statistics & Data Analysis',          department: 'mathematics',      date: '2024-12-15', time: '10:30', location: 'Math Building Room 310',              description: 'Applied statistics for research, including hypothesis testing and regression analysis.',                                                                      capacity: 45,  organizer: 'Prof. Michael Chen',  color: '#8b5cf6', poster: 'posters/event9.jpg'  },
      { id: '10', name: 'Environmental Science Field Trip',    department: 'biology',          date: '2025-01-15', time: '08:00', location: 'Campus Parking Lot (Bus Departure)', description: 'Full-day field trip to study local ecosystems, biodiversity, and environmental conservation.',                                                               capacity: 30,  organizer: 'Dr. Lisa Anderson',   color: '#10b981', poster: 'posters/event10.jpg' },
      { id: '11', name: 'Annual Tech Symposium 2026',          department: 'computer-science', date: '2026-03-11', time: '10:00', location: 'Main Auditorium',                     description: 'Flagship annual tech event featuring student projects, industry talks and competitions.',                                                                   capacity: 200, organizer: 'Dr. Sarah Johnson',   color: '#6366f1', poster: 'posters/event11.jpg' },
    ];

    /* ================================================================
       POSTER IMAGES (cyclic fallback to gradient)
       ================================================================ */
    const posterImages = [
      'posters/event1.jpg',  'posters/event2.jpg',  'posters/event3.jpg',
      'posters/event4.jpg',  'posters/event5.jpg',  'posters/event6.jpg',
      'posters/event7.jpg',  'posters/event8.jpg',  'posters/event9.jpg',
      'posters/event10.jpg', 'posters/event11.jpg',
    ];
    const DEPT_ICONS = {
      'computer-science': 'fa-laptop-code',
      'mathematics':      'fa-square-root-alt',
      'physics':          'fa-atom',
      'chemistry':        'fa-flask',
      'biology':          'fa-dna',
      'english':          'fa-book-open',
      'history':          'fa-landmark',
    };

    /* ================================================================
       UTILITY FUNCTIONS
       ================================================================ */
    function getEventTimeline(dateString) {
      const today = new Date(); today.setHours(0,0,0,0);
      const ev    = new Date(dateString); ev.setHours(0,0,0,0);
      if (ev < today) return 'past';
      if (ev.getTime() === today.getTime()) return 'present';
      return 'future';
    }

    function formatDate(dateString) {
      return new Date(dateString).toLocaleDateString('en-US', {
        weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
      });
    }

    function formatDateLong(dateString) {
      return new Date(dateString).toLocaleDateString('en-US', {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
      });
    }

    function formatTime(timeString) {
      const [hours, minutes] = timeString.split(':');
      const h = parseInt(hours);
      const ampm = h >= 12 ? 'PM' : 'AM';
      return `${h % 12 || 12}:${minutes} ${ampm}`;
    }

    function getDepartmentName(dept) {
      const names = {
        'computer-science': 'Computer Science',
        'mathematics':      'Mathematics',
        'physics':          'Physics',
        'chemistry':        'Chemistry',
        'biology':          'Biology',
        'english':          'English',
        'history':          'History',
      };
      return names[dept] || dept;
    }

    function generateId() {
      return Date.now().toString(36) + Math.random().toString(36).substr(2);
    }

    function getDeptColor(dept) {
      const colors = {
        'computer-science': '#6366f1',
        'mathematics':      '#8b5cf6',
        'physics':          '#ec4899',
        'chemistry':        '#f59e0b',
        'biology':          '#10b981',
        'english':          '#3b82f6',
        'history':          '#ef4444',
      };
      return colors[dept] || '#6366f1';
    }

    /* ================================================================
       TOAST
       ================================================================ */
    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById('toastNotification');
      document.getElementById('toastMessage').textContent = msg;
      el.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
    }

    /* ================================================================
       STATS
       ================================================================ */
    function animateCount(el, target) {
      if (!el) return;
      let current = 0;
      const step = Math.max(1, Math.ceil(target / 15));
      const timer = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = current;
        if (current >= target) clearInterval(timer);
      }, 40);
    }

    function updateStats() {
      const total    = state.events.length;
      const upcoming = state.events.filter(e => getEventTimeline(e.date) === 'future').length;
      const today    = state.events.filter(e => getEventTimeline(e.date) === 'present').length;
      animateCount(document.getElementById('statTotal'),    total);
      animateCount(document.getElementById('statUpcoming'), upcoming);
      animateCount(document.getElementById('statToday'),    today);
      // Update sidebar badge
      const badge = document.getElementById('sidebarEventCount');
      if (badge) badge.textContent = total;
    }

    /* ================================================================
       FILTER LOGIC
       ================================================================ */
    function filterEvents() {
      let filtered = [...state.events];

      if (state.selectedDepartment !== 'all') {
        filtered = filtered.filter(e => e.department === state.selectedDepartment);
      }
      if (state.selectedTimeline !== 'all') {
        filtered = filtered.filter(e => getEventTimeline(e.date) === state.selectedTimeline);
      }
      if (state.searchQuery.trim()) {
        const q = state.searchQuery.toLowerCase();
        filtered = filtered.filter(e =>
          e.name.toLowerCase().includes(q)        ||
          e.description.toLowerCase().includes(q) ||
          e.location.toLowerCase().includes(q)    ||
          e.organizer.toLowerCase().includes(q)
        );
      }

      state.filteredEvents = filtered;
      renderEvents();
      renderSideCalendar();
      if (state.currentView === 'calendar') renderBigCalendar();
      updateStats();
    }

    /* ================================================================
       RENDER EVENTS
       ================================================================ */
    function renderEvents() {
      const grid  = document.getElementById('eventsGrid');
      const empty = document.getElementById('emptyState');
      const count = document.getElementById('resultsCount');

      count.textContent = state.filteredEvents.length;

      if (!state.filteredEvents.length) {
        grid.innerHTML = '';
        empty.classList.add('show');
        return;
      }
      empty.classList.remove('show');

      if (state.currentView === 'grid') {
        grid.className = 'events-grid';
        grid.innerHTML = state.filteredEvents.map((ev, i) => buildGridCard(ev, i)).join('');
      } else if (state.currentView === 'list') {
        grid.className = 'events-list-view';
        grid.innerHTML = state.filteredEvents.map((ev, i) => buildListCard(ev, i)).join('');
      }
    }

    function buildGridCard(ev, idx) {
      const tl       = getEventTimeline(ev.date);
      const tlLabel  = tl === 'present' ? 'Today' : tl === 'future' ? 'Upcoming' : 'Past';
      const imgIdx   = (parseInt(ev.id) - 1) % posterImages.length;
      const imgSrc   = ev.poster || posterImages[imgIdx < 0 ? 0 : imgIdx];
      const icon     = DEPT_ICONS[ev.department] || 'fa-calendar';
      const color    = ev.color || getDeptColor(ev.department);
      const delay    = `${idx * 0.05}s`;

      return `
        <div class="event-card-grid" data-id="${ev.id}" style="animation-delay:${delay}; cursor:pointer;" onclick="goToSpotlight('${ev.id}')">
          <div class="card-poster-wrap">
            <img
              src="${imgSrc}"
              alt="${ev.name}"
              class="card-poster-img"
              onerror="
                this.style.display='none';
                this.nextElementSibling.style.display='flex';
                this.nextElementSibling.style.background='linear-gradient(135deg,${color}dd,${color}88)';
              "
            />
            <div class="card-poster-fallback" style="display:none;">
              <i class="fas ${icon}"></i>
            </div>
            <span class="card-dept-badge" style="border:1px solid ${color}44;">${getDepartmentName(ev.department)}</span>
            <span class="card-timeline-badge badge-${tl}">${tlLabel}</span>
          </div>
          <div class="card-body">
            <div class="card-title">${ev.name}</div>
            <div class="card-meta-list">
              <div class="card-meta-item">
                <i class="fas fa-calendar-alt"></i>
                <span>${formatDate(ev.date)}</span>
              </div>
              <div class="card-meta-item">
                <i class="fas fa-clock"></i>
                <span>${formatTime(ev.time)}</span>
              </div>
              <div class="card-meta-item">
                <i class="fas fa-map-marker-alt"></i>
                <span>${ev.location}</span>
              </div>
            </div>
            <button class="card-view-btn" onclick="event.stopPropagation(); goToSpotlight('${ev.id}')">
              <i class="fas fa-layer-group" style="margin-right:5px;font-size:10px;"></i>View Spotlight
            </button>
          </div>
        </div>
      `;
    }

    function buildListCard(ev, idx) {
      const tl      = getEventTimeline(ev.date);
      const tlLabel = tl === 'present' ? 'Today' : tl === 'future' ? 'Upcoming' : 'Past';
      const color   = ev.color || getDeptColor(ev.department);
      const delay   = `${idx * 0.04}s`;

      return `
        <div class="event-card-list" data-id="${ev.id}"
             style="animation-delay:${delay}; border-left-color:${color}; cursor:pointer;"
             onclick="goToSpotlight('${ev.id}')">
          <div class="list-card-stripe" style="background:${color};"></div>
          <div class="list-card-body">
            <div class="list-card-title">${ev.name}</div>
            <div class="list-card-meta">
              <span class="list-meta-tag"><i class="fas fa-calendar"></i>${formatDate(ev.date)}</span>
              <span class="list-meta-tag"><i class="fas fa-clock"></i>${formatTime(ev.time)}</span>
              <span class="list-meta-tag"><i class="fas fa-map-marker-alt"></i>${ev.location}</span>
              <span class="list-dept-chip">${getDepartmentName(ev.department)}</span>
            </div>
          </div>
          <div class="list-card-right">
            <span class="card-timeline-badge badge-${tl}" style="white-space:nowrap;">${tlLabel}</span>
            <i class="fas fa-chevron-right list-arrow"></i>
          </div>
        </div>
      `;
    }

    /* ================================================================
       SIDE CALENDAR (right panel)
       ================================================================ */
    function renderSideCalendar() {
      const grid    = document.getElementById('calDaysGrid');
      const headers = document.getElementById('calDayHeaders');
      const title   = document.getElementById('currentMonth');

      const year  = state.currentMonth.getFullYear();
      const month = state.currentMonth.getMonth();
      title.textContent = state.currentMonth.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      // Day headers
      const dayNames = ['Su','Mo','Tu','We','Th','Fr','Sa'];
      headers.innerHTML = dayNames.map(d =>
        `<div class="cal-day-header-cell">${d}</div>`
      ).join('');

      // Grid cells
      const firstDay    = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today       = new Date(); today.setHours(0,0,0,0);

      let html = '';
      // Empty leading cells
      for (let i = 0; i < firstDay; i++) {
        html += `<div class="cal-day-cell empty"></div>`;
      }
      // Day cells
      for (let d = 1; d <= daysInMonth; d++) {
        const date   = new Date(year, month, d);
        const ds     = date.toISOString().split('T')[0];
        const isToday = date.getTime() === today.getTime();
        const dayEvs  = state.filteredEvents.filter(e => e.date === ds);

        const dotHtml = dayEvs.slice(0, 3).map(e => {
          const tl = getEventTimeline(e.date);
          return `<span class="cal-dot dot-${tl}"></span>`;
        }).join('');

        html += `
          <div class="cal-day-cell${isToday ? ' is-today' : ''}${dayEvs.length ? ' has-event' : ''}"
               data-date="${ds}"
               onclick="onSideCalDayClick('${ds}', this)">
            <span class="cal-day-number">${d}</span>
            ${dayEvs.length ? `<div class="cal-event-dots">${dotHtml}</div>` : ''}
          </div>
        `;
      }
      grid.innerHTML = html;
    }

    function onSideCalDayClick(ds, el) {
      // Deselect all
      document.querySelectorAll('#calDaysGrid .cal-day-cell').forEach(c => c.classList.remove('selected'));
      const dayEvs = state.filteredEvents.filter(e => e.date === ds);
      if (!dayEvs.length) { closeSideCalPanel(); return; }
      el.classList.add('selected');
      openSideCalPanel(ds, dayEvs);
    }

    function openSideCalPanel(ds, evs) {
      const panel = document.getElementById('calDayPanel');
      const title = document.getElementById('calDayPanelTitle');
      const list  = document.getElementById('calDayEventsList');

      const d = new Date(ds);
      title.textContent = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });

      list.innerHTML = evs.map(ev => `
        <div class="cal-day-event-item" style="border-left-color:${ev.color || getDeptColor(ev.department)};"
             onclick="goToSpotlight('${ev.id}')">
          <span class="cal-day-event-name">${ev.name}</span>
          <div class="cal-day-event-meta">
            <i class="fas fa-clock"></i> ${formatTime(ev.time)}
            &nbsp;·&nbsp;
            <i class="fas fa-map-marker-alt"></i> ${ev.location}
          </div>
        </div>
      `).join('');

      panel.classList.add('open');
    }

    function closeSideCalPanel() {
      document.getElementById('calDayPanel').classList.remove('open');
      document.querySelectorAll('#calDaysGrid .cal-day-cell').forEach(c => c.classList.remove('selected'));
    }

    function changeSideMonth(delta) {
      state.currentMonth.setMonth(state.currentMonth.getMonth() + delta);
      renderSideCalendar();
    }

    /* ================================================================
       BIG CALENDAR VIEW
       ================================================================ */
    function renderBigCalendar() {
      const grid    = document.getElementById('bigCalGrid');
      const headers = document.getElementById('bigCalDayHeaders');
      const title   = document.getElementById('bigCalMonthTitle');

      const year  = state.currentMonth.getFullYear();
      const month = state.currentMonth.getMonth();
      title.textContent = state.currentMonth.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      headers.innerHTML = dayNames.map(d =>
        `<div class="big-cal-day-header-cell">${d}</div>`
      ).join('');

      const firstDay    = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today       = new Date(); today.setHours(0,0,0,0);

      let html = '';
      for (let i = 0; i < firstDay; i++) html += `<div class="big-cal-day empty"></div>`;

      for (let d = 1; d <= daysInMonth; d++) {
        const date    = new Date(year, month, d);
        const ds      = date.toISOString().split('T')[0];
        const isToday = date.getTime() === today.getTime();
        const dayEvs  = state.filteredEvents.filter(e => e.date === ds);

        const dotHtml = dayEvs.slice(0, 4).map(e => {
          const tl = getEventTimeline(e.date);
          return `<span class="cal-dot dot-${tl}"></span>`;
        }).join('');

        html += `
          <div class="big-cal-day${isToday ? ' is-today' : ''}${dayEvs.length ? ' has-event' : ''}"
               data-date="${ds}"
               onclick="onBigCalDayClick('${ds}', this)">
            <div class="big-cal-day-num">${d}</div>
            ${dayEvs.length ? `<div class="big-cal-dots">${dotHtml}</div>` : ''}
          </div>
        `;
      }
      grid.innerHTML = html;
    }

    function onBigCalDayClick(ds, el) {
      document.querySelectorAll('#bigCalGrid .big-cal-day').forEach(d => d.classList.remove('selected'));
      const dayEvs = state.filteredEvents.filter(e => e.date === ds);
      if (!dayEvs.length) { closeBigCalPanel(); return; }
      el.classList.add('selected');
      openBigCalPanel(ds, dayEvs);
    }

    function openBigCalPanel(ds, evs) {
      const panel = document.getElementById('bigCalSidePanel');
      const title = document.getElementById('bigCalSideTitle');
      const list  = document.getElementById('bigCalSideEvents');

      const d = new Date(ds);
      title.textContent = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });

      list.innerHTML = evs.map(ev => `
        <div class="cal-day-event-item" style="border-left-color:${ev.color || getDeptColor(ev.department)};"
             onclick="goToSpotlight('${ev.id}')">
          <span class="cal-day-event-name">${ev.name}</span>
          <div class="cal-day-event-meta">
            <i class="fas fa-clock"></i> ${formatTime(ev.time)}
            &nbsp;·&nbsp;
            <i class="fas fa-map-marker-alt"></i> ${ev.location}
          </div>
        </div>
      `).join('');

      panel.classList.add('open');
    }

    function closeBigCalPanel() {
      document.getElementById('bigCalSidePanel').classList.remove('open');
      document.querySelectorAll('#bigCalGrid .big-cal-day').forEach(d => d.classList.remove('selected'));
    }

    /* ================================================================
       VIEW SWITCHING
       ================================================================ */
    function setView(view) {
      state.currentView = view;
      const gridSection   = document.getElementById('eventsGridSection');
      const calSection    = document.getElementById('calendarFullSection');
      const calSideCol    = document.getElementById('calendarSidePanelCol');
      const gridBtn = document.getElementById('gridViewBtn');
      const listBtn = document.getElementById('listViewBtn');
      const calBtn  = document.getElementById('calViewBtn');

      [gridBtn, listBtn, calBtn].forEach(b => b.classList.remove('active'));

      if (view === 'grid' || view === 'list') {
        gridSection.style.display = 'block';
        calSection.classList.remove('show');
        calSideCol.style.display = '';
        renderEvents();
        if (view === 'grid') gridBtn.classList.add('active');
        else                 listBtn.classList.add('active');
      } else {
        // Calendar full view
        gridSection.style.display = 'none';
        calSection.classList.add('show');
        calSideCol.style.display = 'none';
        calBtn.classList.add('active');
        renderBigCalendar();
      }
    }

    /* ================================================================
       DETAIL MODAL
       ================================================================ */
    function goToSpotlight(id) {
      window.location.href = 'bento.html?id=' + id;
    }

    function openDetailModal(id) {
      const ev = state.events.find(e => e.id === id);
      if (!ev) return;
      state.openDetailId = id;

      const tl      = getEventTimeline(ev.date);
      const tlLabel = tl === 'present' ? 'Today' : tl === 'future' ? 'Upcoming' : 'Past';

      const badge = document.getElementById('detailBadge');
      badge.textContent = tlLabel;
      badge.className   = `detail-badge badge-${tl}`;

      document.getElementById('detailTitle').textContent    = ev.name;
      document.getElementById('detailDept').textContent     = getDepartmentName(ev.department);
      document.getElementById('detailDate').textContent     = formatDateLong(ev.date);
      document.getElementById('detailTime').textContent     = formatTime(ev.time);
      document.getElementById('detailVenue').textContent    = ev.location;
      document.getElementById('detailOrganizer').textContent = ev.organizer || 'TBD';
      document.getElementById('detailCapacity').textContent  = `${ev.capacity || '—'} seats`;
      document.getElementById('detailDesc').textContent     = ev.description || 'No description provided.';

      document.getElementById('detailEditBtn').dataset.id   = id;

      // Wire the "View Full Details" spotlight button to navigate to bento.html
      const spotBtn = document.getElementById('detailSpotlightBtn');
      spotBtn.onclick = function() { goToSpotlight(id); };

      const backdrop = document.getElementById('detailModalBackdrop');
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDetailModal() {
      document.getElementById('detailModalBackdrop').classList.remove('open');
      document.body.style.overflow = '';
      state.openDetailId = null;
    }

    /* ================================================================
       ADD / EDIT MODAL
       ================================================================ */
    function openAddModal() {
      state.editingEventId = null;
      document.getElementById('formModalTitle').textContent = 'Add New Event';
      document.getElementById('eventForm').reset();
      document.getElementById('eventId').value = '';
      document.getElementById('formModalBackdrop').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function openEditModal(ev) {
      state.editingEventId = ev.id;
      document.getElementById('formModalTitle').textContent  = 'Edit Event';
      document.getElementById('eventId').value               = ev.id;
      document.getElementById('eventName').value             = ev.name;
      document.getElementById('eventDepartment').value       = ev.department;
      document.getElementById('eventDate').value             = ev.date;
      document.getElementById('eventTime').value             = ev.time;
      document.getElementById('eventLocation').value         = ev.location;
      document.getElementById('eventDescription').value      = ev.description || '';
      document.getElementById('eventCapacity').value         = ev.capacity || '';
      document.getElementById('eventOrganizer').value        = ev.organizer || '';
      document.getElementById('formModalBackdrop').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeFormModal() {
      document.getElementById('formModalBackdrop').classList.remove('open');
      document.getElementById('eventForm').reset();
      state.editingEventId = null;
      document.body.style.overflow = '';
    }

    function saveEvent(e) {
      e.preventDefault();
      const deptColors = {
        'computer-science': '#6366f1', 'mathematics': '#8b5cf6',
        'physics': '#ec4899',          'chemistry':   '#f59e0b',
        'biology': '#10b981',          'english':     '#3b82f6',
        'history': '#ef4444',
      };
      const dept = document.getElementById('eventDepartment').value;
      const evData = {
        name:        document.getElementById('eventName').value.trim(),
        department:  dept,
        date:        document.getElementById('eventDate').value,
        time:        document.getElementById('eventTime').value,
        location:    document.getElementById('eventLocation').value.trim(),
        description: document.getElementById('eventDescription').value.trim(),
        capacity:    parseInt(document.getElementById('eventCapacity').value) || 50,
        organizer:   document.getElementById('eventOrganizer').value.trim() || 'Staff',
        color:       deptColors[dept] || '#6366f1',
      };

      const id = document.getElementById('eventId').value;
      if (id) {
        const idx = state.events.findIndex(ev => ev.id === id);
        if (idx !== -1) {
          state.events[idx] = { ...state.events[idx], ...evData };
          showToast('Event updated successfully');
        }
      } else {
        state.events.unshift({ id: generateId(), ...evData });
        showToast('Event added successfully');
      }

      closeFormModal();
      filterEvents();
    }

    /* ================================================================
       EXPORT CSV
       ================================================================ */
    function exportEvents() {
      if (!state.filteredEvents.length) {
        showToast('No events to export');
        return;
      }
      const headers = ['Name','Department','Date','Time','Location','Organizer','Capacity','Status'];
      const rows = state.filteredEvents.map(ev => [
        `"${ev.name}"`,
        `"${getDepartmentName(ev.department)}"`,
        `"${formatDateLong(ev.date)}"`,
        `"${formatTime(ev.time)}"`,
        `"${ev.location}"`,
        `"${ev.organizer}"`,
        ev.capacity,
        `"${getEventTimeline(ev.date).toUpperCase()}"`,
      ]);
      const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url  = URL.createObjectURL(blob);
      const a    = Object.assign(document.createElement('a'), {
        href: url,
        download: `jain_events_${new Date().toISOString().split('T')[0]}.csv`,
      });
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Exported successfully');
    }

    /* ================================================================
       SIDEBAR
       ================================================================ */
    function openSidebar() {
      document.getElementById('sidebar').classList.add('open');
      document.getElementById('sidebarBackdrop').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarBackdrop').classList.remove('open');
      document.body.style.overflow = '';
    }

    /* ================================================================
       PROFILE DROPDOWN
       ================================================================ */
    function toggleProfileDropdown() {
      document.getElementById('profileDropdown').classList.toggle('open');
    }
    function closeProfileDropdown() {
      document.getElementById('profileDropdown').classList.remove('open');
    }

    /* ================================================================
       INIT & EVENT LISTENERS
       ================================================================ */
    document.addEventListener('DOMContentLoaded', function () {
      // Populate navbar with logged-in user info
      if (window.JainAuth) {
        window.JainAuth.populateNavbar();
        // Also populate sidebar
        var u = window.JainAuth.getUser();
        if (u) {
          var ini = (u.name||'JU').split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2);
          var sini = document.getElementById('sidebarUserInitials');
          var sname = document.getElementById('sidebarUserName');
          var srole = document.getElementById('sidebarUserRole');
          if(sini) sini.textContent = ini;
          if(sname) sname.textContent = u.name || 'Jain University';
          if(srole) srole.textContent = u.role || 'Student';
        }
      }
      // Load data
      state.events = [...sampleEvents];
      filterEvents();

      // Hamburger
      document.getElementById('hamburgerBtn').addEventListener('click', openSidebar);
      document.getElementById('sidebarCloseBtn').addEventListener('click', closeSidebar);
      document.getElementById('sidebarBackdrop').addEventListener('click', closeSidebar);

      // Profile dropdown
      document.getElementById('profileAvatarBtn').addEventListener('click', function (e) {
        e.stopPropagation();
        toggleProfileDropdown();
      });
      document.addEventListener('click', function () { closeProfileDropdown(); });
      document.getElementById('profileDropdown').addEventListener('click', e => e.stopPropagation());

      // Add Event button
      document.getElementById('addEventBtn').addEventListener('click', openAddModal);

      // Department filter
      document.getElementById('departmentSelect').addEventListener('change', function () {
        state.selectedDepartment = this.value;
        filterEvents();
      });

      // Timeline pills
      document.querySelectorAll('.tl-pill').forEach(btn => {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.tl-pill').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          state.selectedTimeline = this.dataset.timeline;
          filterEvents();
        });
      });

      // Search
      document.getElementById('searchInput').addEventListener('input', function () {
        state.searchQuery = this.value;
        filterEvents();
      });

      // View buttons
      document.getElementById('gridViewBtn').addEventListener('click', () => setView('grid'));
      document.getElementById('listViewBtn').addEventListener('click', () => setView('list'));
      document.getElementById('calViewBtn').addEventListener('click',  () => setView('calendar'));

      // Export
      document.getElementById('exportBtn').addEventListener('click', exportEvents);

      // Side calendar navigation
      document.getElementById('prevMonth').addEventListener('click', () => changeSideMonth(-1));
      document.getElementById('nextMonth').addEventListener('click', () => changeSideMonth(1));
      document.getElementById('calDayPanelClose').addEventListener('click', closeSideCalPanel);

      // Big calendar navigation
      document.getElementById('prevMonthBig').addEventListener('click', function () {
        state.currentMonth.setMonth(state.currentMonth.getMonth() - 1);
        renderBigCalendar();
        renderSideCalendar();
      });
      document.getElementById('nextMonthBig').addEventListener('click', function () {
        state.currentMonth.setMonth(state.currentMonth.getMonth() + 1);
        renderBigCalendar();
        renderSideCalendar();
      });
      document.getElementById('bigCalSideClose').addEventListener('click', closeBigCalPanel);

      // Detail modal close
      document.getElementById('detailCloseBtn').addEventListener('click', closeDetailModal);
      document.getElementById('detailModalBackdrop').addEventListener('click', function (e) {
        if (e.target === this) closeDetailModal();
      });
      document.getElementById('detailEditBtn').addEventListener('click', function () {
        const id = this.dataset.id;
        closeDetailModal();
        const ev = state.events.find(e => e.id === id);
        if (ev) openEditModal(ev);
      });

      // Form modal
      document.getElementById('eventForm').addEventListener('submit', saveEvent);
      document.getElementById('formModalClose').addEventListener('click', closeFormModal);
      document.getElementById('formCancelBtn').addEventListener('click', closeFormModal);
      document.getElementById('formModalBackdrop').addEventListener('click', function (e) {
        if (e.target === this) closeFormModal();
      });

      // Keyboard ESC
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeFormModal();
          closeDetailModal();
          closeSidebar();
        }
      });
    });
  </script>
</body>
</html>
