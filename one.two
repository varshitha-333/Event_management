<!DOCTYPE html>
<html lang="en">
<head>sdf
  <!-- ╔══════════════════════════════════════════════╗
       ║  AUTH GUARD — DO NOT REMOVE                 ║
       ╚══════════════════════════════════════════════╝ -->
  <script src="auth.js"></script>
  <script>
    // Redirect to login.html if not authenticated
    if (window.JainAuth) { window.JainAuth.requireAuth(); }
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Department Events Portal — Jain University</title>

  <!-- Google Fonts: Sora + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sora:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sora: ['Sora', 'sans-serif'],
            inter: ['Inter', 'sans-serif'],
          },
          colors: {
            navy: {
              DEFAULT: '#1C2B4A',
              deep: '#111C33',
              mid: '#2E4370',
              light: '#3A5C8C',
            },
            gold: {
              DEFAULT: '#C8920A',
              light: '#E8B030',
              pale: '#FDF3DC',
            },
          },
        },
      },
    };
  </script>

  <style>
    /* ============================================================
       DESIGN SYSTEM & CUSTOM STYLES
       ============================================================ */
    :root {
      --navy:        #1C2B4A;
      --navy-deep:   #111C33;
      --navy-mid:    #2E4370;
      --navy-light:  #3A5C8C;
      --gold:        #C8920A;
      --gold-light:  #E8B030;
      --gold-pale:   #FDF3DC;
      --white:       #FFFFFF;
      --surface:     #F7F8FC;
      --surface2:    #EFF1F7;
      --border:      #DDE1EE;
      --text-dark:   #0F1B33;
      --text-mid:    #374151;
      --text-soft:   #6B7280;
      --text-pale:   #9CA3AF;
      --r-sm: 6px;
      --r-md: 12px;
      --r-lg: 18px;
      --r-xl: 24px;
      --shadow-sm: 0 1px 4px rgba(28,43,74,.07);
      --shadow-md: 0 4px 20px rgba(28,43,74,.10);
      --shadow-lg: 0 12px 40px rgba(28,43,74,.15);
      --transition: .22s cubic-bezier(.4,0,.2,1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--surface);
      color: var(--text-dark);
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── ANIMATIONS ── */
    @keyframes slideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to   { transform: translateY(0);     opacity: 1; }
    }
    @keyframes fadeInUp {
      from { transform: translateY(20px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scaleIn {
      from { transform: scale(0.94); opacity: 0; }
      to   { transform: scale(1);    opacity: 1; }
    }
    @keyframes slideInLeft {
      from { transform: translateX(-100%); }
      to   { transform: translateX(0); }
    }
    @keyframes slideInRight {
      from { transform: translateX(40px); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }
    @keyframes countUp {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }

    /* ── NAVBAR ── */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 200;
      background: var(--navy);
      border-bottom: 2px solid var(--gold);
      box-shadow: 0 4px 24px rgba(0,0,0,.22);
      animation: slideDown 0.5s cubic-bezier(.34,1.1,.64,1) both;
    }
    .navbar-inner {
      max-width: 1400px;
      margin: 0 auto;
      height: 72px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    /* Hamburger */
    .hamburger-btn {
      width: 40px; height: 40px;
      background: rgba(255,255,255,.08);
      border: 1.5px solid rgba(255,255,255,.15);
      border-radius: 10px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 5px;
      cursor: pointer;
      transition: var(--transition);
      flex-shrink: 0;
    }
    .hamburger-btn:hover { background: rgba(255,255,255,.16); border-color: var(--gold); }
    .hamburger-line {
      width: 18px; height: 2px;
      background: var(--white);
      border-radius: 2px;
      transition: var(--transition);
    }

    /* Logo block */
    .nav-logo-badge {
      width: 48px; height: 48px;
      background: var(--gold);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Sora', sans-serif;
      font-weight: 900; font-size: 14px;
      color: var(--navy);
      letter-spacing: .5px;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(200,146,10,.35);
      transition: var(--transition);
    }
    .nav-logo-badge:hover { transform: scale(1.05); }
    .nav-brand-text { display: flex; flex-direction: column; gap: 1px; }
    .nav-university-name {
      font-family: 'Sora', sans-serif;
      font-size: 17px; font-weight: 800;
      color: var(--white);
      line-height: 1;
      letter-spacing: -.2px;
    }
    .nav-portal-name {
      font-size: 11px;
      color: rgba(255,255,255,.5);
      letter-spacing: .6px;
      font-weight: 500;
    }

    /* Nav spacer */
    .nav-spacer { flex: 1; }

    /* Profile dropdown */
    .profile-wrapper { position: relative; }
    .profile-avatar-btn {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
      border: 2px solid rgba(200,146,10,.5);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Sora', sans-serif;
      font-size: 13px; font-weight: 800;
      color: var(--white);
      cursor: pointer;
      transition: var(--transition);
      position: relative;
    }
    .profile-avatar-btn:hover { border-color: var(--gold); transform: scale(1.05); }
    .profile-online-dot {
      position: absolute;
      bottom: 1px; right: 1px;
      width: 8px; height: 8px;
      background: #22c55e;
      border-radius: 50%;
      border: 1.5px solid var(--navy);
      animation: pulse-dot 2s infinite;
    }
    .profile-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 200px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-lg);
      padding: 8px;
      transform: translateY(6px) scale(.97);
      opacity: 0;
      pointer-events: none;
      transition: transform .2s cubic-bezier(.34,1.3,.64,1), opacity .18s;
      z-index: 300;
    }
    .profile-dropdown.open {
      transform: translateY(0) scale(1);
      opacity: 1;
      pointer-events: all;
    }
    .dropdown-header {
      padding: 8px 12px 12px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 6px;
    }
    .dropdown-header-name {
      font-size: 13px; font-weight: 700;
      color: var(--text-dark);
    }
    .dropdown-header-role {
      font-size: 11px;
      color: var(--text-pale);
    }
    .dropdown-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px; font-weight: 500;
      color: var(--text-mid);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
    }
    .dropdown-item:hover { background: var(--surface); color: var(--navy); }
    .dropdown-item i { width: 16px; text-align: center; color: var(--text-pale); font-size: 12px; }
    .dropdown-item:hover i { color: var(--gold); }
    .dropdown-divider { height: 1px; background: var(--border); margin: 4px 0; }

    /* Add Event button */
    .add-event-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 18px;
      background: var(--gold);
      color: var(--navy);
      border: none;
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(200,146,10,.3);
    }
    .add-event-btn:hover {
      background: var(--gold-light);
      transform: scale(1.02);
      box-shadow: 0 4px 16px rgba(200,146,10,.4);
    }

    /* ── SIDEBAR ── */
    .sidebar-backdrop {
      position: fixed; inset: 0; z-index: 400;
      background: rgba(11,17,30,.6);
      backdrop-filter: blur(4px);
      opacity: 0; pointer-events: none;
      transition: opacity .3s;
    }
    .sidebar-backdrop.open { opacity: 1; pointer-events: all; }

    .sidebar {
      position: fixed;
      top: 0; left: 0;
      height: 100%;
      width: 280px;
      background: var(--navy-deep);
      z-index: 500;
      transform: translateX(-100%);
      transition: transform .32s cubic-bezier(.4,0,.2,1);
      display: flex; flex-direction: column;
      box-shadow: 8px 0 40px rgba(0,0,0,.35);
    }
    .sidebar.open { transform: translateX(0); }

    .sidebar-header {
      padding: 24px 20px 20px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      display: flex; align-items: center; justify-content: space-between;
    }
    .sidebar-logo-group {
      display: flex; align-items: center; gap: 12px;
    }
    .sidebar-logo-badge {
      width: 42px; height: 42px;
      background: var(--gold);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Sora', sans-serif;
      font-size: 13px; font-weight: 900;
      color: var(--navy);
    }
    .sidebar-close-btn {
      width: 32px; height: 32px;
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,.6);
      cursor: pointer;
      font-size: 14px;
      transition: var(--transition);
    }
    .sidebar-close-btn:hover { background: rgba(255,255,255,.15); color: var(--white); }

    .sidebar-nav { flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; }
    .sidebar-section-label {
      font-size: 10px; font-weight: 700;
      letter-spacing: 1.2px; text-transform: uppercase;
      color: rgba(255,255,255,.3);
      padding: 10px 8px 6px;
    }
    .sidebar-nav-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 14px;
      border-radius: 10px;
      font-size: 14px; font-weight: 500;
      color: rgba(255,255,255,.6);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
      position: relative;
    }
    .sidebar-nav-item:hover {
      background: rgba(255,255,255,.07);
      color: var(--white);
    }
    .sidebar-nav-item.active {
      background: rgba(200,146,10,.15);
      color: var(--gold-light);
      font-weight: 600;
    }
    .sidebar-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0; top: 50%;
      transform: translateY(-50%);
      width: 3px; height: 22px;
      background: var(--gold);
      border-radius: 0 3px 3px 0;
    }
    .sidebar-nav-item i {
      width: 18px; text-align: center;
      font-size: 15px;
    }
    .sidebar-nav-badge {
      margin-left: auto;
      background: var(--gold);
      color: var(--navy);
      font-size: 10px; font-weight: 800;
      padding: 2px 7px;
      border-radius: 20px;
    }
    .sidebar-footer {
      padding: 16px 12px 24px;
      border-top: 1px solid rgba(255,255,255,.08);
    }
    .sidebar-user-card {
      display: flex; align-items: center; gap: 12px;
      padding: 12px;
      background: rgba(255,255,255,.05);
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.08);
    }
    .sidebar-user-avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
      border: 2px solid rgba(200,146,10,.4);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 800;
      color: var(--white);
      flex-shrink: 0;
    }
    .sidebar-user-info { flex: 1; min-width: 0; }
    .sidebar-user-name { font-size: 13px; font-weight: 600; color: var(--white); }
    .sidebar-user-role { font-size: 11px; color: rgba(255,255,255,.4); }

    /* ── HERO SECTION ── */
    .hero-outer {
      background: var(--surface);
      padding: 28px 24px 0;
    }
    .hero-container {
      max-width: 1100px;
      margin: 0 auto;
      border-radius: 24px;
      overflow: hidden;
      position: relative;
      height: 320px;
      box-shadow: 0 20px 60px rgba(17,28,51,.25);
      animation: scaleIn 0.6s cubic-bezier(.34,1.1,.64,1) 0.15s both;
    }
    .hero-bg-img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 40%;
      display: block;
      position: absolute; inset: 0;
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(
        105deg,
        rgba(11,17,30,.92) 0%,
        rgba(28,43,74,.82) 45%,
        rgba(28,43,74,.4)  100%
      );
    }
    /* Glass shimmer strip */
    .hero-glass-strip {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 80px;
      background: linear-gradient(to top, rgba(11,17,30,.6), transparent);
      backdrop-filter: blur(2px);
    }
    .hero-content {
      position: relative; z-index: 2;
      height: 100%;
      padding: 36px 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
      max-width: 640px;
    }
    .hero-eyebrow {
      display: flex; align-items: center; gap: 8px;
      font-size: 11px; font-weight: 700;
      color: var(--gold-light);
      letter-spacing: 1.8px;
      text-transform: uppercase;
      animation: fadeInUp 0.5s 0.35s both;
    }
    .hero-eyebrow-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 8px rgba(200,146,10,.8);
      animation: pulse-dot 2s infinite;
    }
    .hero-heading {
      font-family: 'Sora', sans-serif;
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 900;
      line-height: 1.1;
      color: var(--white);
      animation: fadeInUp 0.5s 0.45s both;
    }
    .hero-heading-accent { color: var(--gold-light); display: block; }
    .hero-subtitle {
      font-size: 14px;
      color: rgba(255,255,255,.65);
      max-width: 400px;
      line-height: 1.6;
      animation: fadeInUp 0.5s 0.55s both;
    }
    .hero-stats-row {
      display: flex; align-items: center; gap: 0;
      margin-top: 8px;
      animation: fadeInUp 0.5s 0.65s both;
    }
    .hero-stat {
      display: flex; flex-direction: column; gap: 2px;
      padding-right: 24px;
    }
    .hero-stat-num {
      font-family: 'Sora', sans-serif;
      font-size: 28px; font-weight: 900;
      color: var(--white);
      line-height: 1;
    }
    .hero-stat-num.gold { color: var(--gold-light); }
    .hero-stat-label { font-size: 11px; color: rgba(255,255,255,.5); letter-spacing: .5px; }
    .hero-stat-sep {
      width: 1px; height: 36px;
      background: rgba(255,255,255,.2);
      margin: 0 24px;
      flex-shrink: 0;
    }

    /* ── PAGE LAYOUT ── */
    .page-body {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px 60px;
    }

    /* ── FILTER BAR ── */
    .filter-bar-wrapper {
      position: sticky;
      top: 72px;
      z-index: 100;
      padding: 16px 0;
      background: var(--surface);
    }
    .filter-bar-card {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 2px 16px rgba(28,43,74,.07);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      transition: box-shadow var(--transition);
      animation: fadeInUp 0.4s 0.3s both;
    }
    .filter-bar-card:hover { box-shadow: 0 6px 28px rgba(28,43,74,.1); }

    /* Search input */
    .filter-search-wrap {
      position: relative;
      flex: 1;
      min-width: 180px;
    }
    .filter-search-icon {
      position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
      color: var(--text-pale); font-size: 13px;
      pointer-events: none;
    }
    .filter-search {
      width: 100%;
      padding: 9px 14px 9px 36px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 13px; font-family: 'Inter', sans-serif;
      color: var(--text-dark);
      background: var(--surface);
      outline: none;
      transition: var(--transition);
    }
    .filter-search:focus { border-color: var(--navy); background: var(--white); box-shadow: 0 0 0 3px rgba(28,43,74,.07); }
    .filter-search::placeholder { color: var(--text-pale); }

    /* Department dropdown */
    .filter-select-wrap { position: relative; }
    .filter-select-icon {
      position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
      color: var(--text-pale); font-size: 12px; pointer-events: none;
    }
    .filter-select {
      appearance: none;
      padding: 9px 32px 9px 32px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 13px; font-family: 'Inter', sans-serif;
      color: var(--text-dark);
      background: var(--surface);
      cursor: pointer; outline: none;
      transition: var(--transition);
      min-width: 175px;
    }
    .filter-select:focus { border-color: var(--navy); background: var(--white); }
    .filter-select-arrow {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      font-size: 10px; color: var(--text-pale); pointer-events: none;
    }

    /* Timeline pills */
    .filter-divider { width: 1px; height: 30px; background: var(--border); flex-shrink: 0; }
    .timeline-pills {
      display: flex; gap: 3px;
      padding: 3px;
      background: var(--surface);
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .tl-pill {
      padding: 6px 14px;
      border: none; background: transparent;
      font-family: 'Inter', sans-serif;
      font-size: 12px; font-weight: 500;
      color: var(--text-soft);
      border-radius: 7px;
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
    }
    .tl-pill:hover { color: var(--navy); background: rgba(28,43,74,.05); }
    .tl-pill.active {
      background: var(--navy);
      color: var(--white);
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(28,43,74,.2);
    }

    /* View + export */
    .view-toggle {
      display: flex; gap: 3px;
      padding: 3px;
      background: var(--surface);
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .vt-btn {
      width: 34px; height: 34px;
      border: none; background: transparent;
      border-radius: 7px;
      color: var(--text-pale);
      cursor: pointer; font-size: 13px;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .vt-btn:hover { color: var(--navy); background: rgba(28,43,74,.06); }
    .vt-btn.active { background: var(--navy); color: var(--white); box-shadow: 0 2px 8px rgba(28,43,74,.2); }

    .export-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      background: var(--white);
      font-family: 'Inter', sans-serif;
      font-size: 12px; font-weight: 600;
      color: var(--text-mid);
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
    }
    .export-btn:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-pale); }

    /* Results count */
    .results-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 6px 2px 14px;
    }
    .results-count {
      font-size: 13px; color: var(--text-soft); font-weight: 500;
    }
    .results-count strong { color: var(--navy); font-weight: 700; }

    /* ── TWO-COLUMN LAYOUT ── */
    .content-layout {
      display: flex;
      gap: 24px;
      align-items: flex-start;
    }
    .events-column { flex: 1; min-width: 0; }
    .calendar-column {
      width: 320px;
      flex-shrink: 0;
      position: sticky;
      top: 160px;
      max-height: calc(100vh - 180px);
      overflow-y: auto;
    }
    .calendar-column::-webkit-scrollbar { width: 4px; }
    .calendar-column::-webkit-scrollbar-track { background: transparent; }
    .calendar-column::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

    /* ── EVENT GRID ── */
    .events-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .events-list-view {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* ── EVENT CARD (GRID) ── */
    .event-card-grid {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      transition: transform .25s cubic-bezier(.4,0,.2,1), box-shadow .25s;
      box-shadow: var(--shadow-sm);
      animation: fadeInUp 0.4s both;
    }
    .event-card-grid:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 40px rgba(28,43,74,.13);
      border-color: rgba(28,43,74,.2);
    }

    /* Poster image area */
    .card-poster-wrap {
      position: relative;
      height: 160px;
      overflow: hidden;
    }
    .card-poster-img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .4s cubic-bezier(.4,0,.2,1);
      display: block;
    }
    .event-card-grid:hover .card-poster-img { transform: scale(1.06); }
    .card-poster-fallback {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 36px;
      color: rgba(255,255,255,.7);
    }
    .card-dept-badge {
      position: absolute;
      bottom: 10px; left: 12px;
      font-size: 11px; font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      background: rgba(0,0,0,.55);
      color: var(--white);
      backdrop-filter: blur(6px);
      letter-spacing: .3px;
    }
    .card-timeline-badge {
      position: absolute;
      top: 10px; right: 10px;
      font-size: 10px; font-weight: 800;
      padding: 3px 9px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: .6px;
    }
    .badge-future  { background: #EAF0FB; color: #1D4ED8; }
    .badge-present { background: var(--gold-pale); color: var(--gold); }
    .badge-past    { background: var(--surface2); color: var(--text-soft); }

    /* Card body */
    .card-body { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .card-title {
      font-family: 'Sora', sans-serif;
      font-size: 14px; font-weight: 700;
      color: var(--text-dark);
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-meta-list { display: flex; flex-direction: column; gap: 5px; }
    .card-meta-item {
      display: flex; align-items: center; gap: 7px;
      font-size: 12px; color: var(--text-soft);
    }
    .card-meta-item i {
      font-size: 11px; width: 14px; text-align: center;
      color: var(--text-pale);
      flex-shrink: 0;
    }
    .card-meta-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .card-view-btn {
      width: 100%;
      padding: 8px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      background: transparent;
      font-family: 'Inter', sans-serif;
      font-size: 12px; font-weight: 600;
      color: var(--navy);
      cursor: pointer;
      transition: var(--transition);
      margin-top: 2px;
    }
    .card-view-btn:hover { background: var(--navy); color: var(--white); border-color: var(--navy); }

    /* ── EVENT CARD (LIST) ── */
    .event-card-list {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      cursor: pointer;
      transition: transform .22s, box-shadow .22s, border-color .22s;
      box-shadow: var(--shadow-sm);
      display: grid;
      grid-template-columns: 5px 1fr auto;
      align-items: center;
      animation: fadeInUp 0.35s both;
    }
    .event-card-list:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: rgba(28,43,74,.25);
    }
    .list-card-stripe { height: 100%; }
    .list-card-body {
      padding: 14px 18px;
      display: flex; flex-direction: column; gap: 6px;
      min-width: 0;
    }
    .list-card-title {
      font-family: 'Sora', sans-serif;
      font-size: 14px; font-weight: 700;
      color: var(--text-dark);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .list-card-meta {
      display: flex; align-items: center; flex-wrap: wrap;
      gap: 4px 14px;
    }
    .list-meta-tag {
      display: flex; align-items: center; gap: 5px;
      font-size: 12px; color: var(--text-soft);
    }
    .list-meta-tag i { font-size: 10px; color: var(--text-pale); }
    .list-dept-chip {
      font-size: 10px; font-weight: 700;
      padding: 2px 9px;
      border-radius: 20px;
      background: var(--surface2);
      color: var(--navy);
    }
    .list-card-right {
      padding: 0 18px;
      display: flex; align-items: center; gap: 12px;
      flex-shrink: 0;
    }
    .list-arrow {
      color: var(--text-pale); font-size: 13px;
      transition: var(--transition);
    }
    .event-card-list:hover .list-arrow { color: var(--navy); transform: translateX(3px); }

    /* ── EMPTY STATE ── */
    .empty-state {
      display: none;
      flex-direction: column; align-items: center;
      padding: 80px 24px;
      gap: 14px; text-align: center;
    }
    .empty-state.show { display: flex; animation: fadeIn 0.3s both; }
    .empty-icon { font-size: 52px; color: var(--border); margin-bottom: 4px; }

    /* ── CALENDAR PANEL ── */
    .cal-panel-card {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      animation: slideInRight 0.5s 0.3s both;
    }
    .cal-panel-header {
      background: var(--navy);
      padding: 16px 18px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .cal-month-title {
      font-family: 'Sora', sans-serif;
      font-size: 15px; font-weight: 800;
      color: var(--white);
    }
    .cal-nav-btn {
      width: 30px; height: 30px;
      border: 1.5px solid rgba(255,255,255,.2);
      background: transparent;
      border-radius: 8px;
      color: var(--white);
      cursor: pointer; font-size: 11px;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .cal-nav-btn:hover { border-color: var(--gold); color: var(--gold); }

    .cal-grid-container { padding: 12px; }
    .cal-day-headers {
      display: grid; grid-template-columns: repeat(7, 1fr);
      margin-bottom: 4px;
    }
    .cal-day-header-cell {
      text-align: center;
      font-size: 10px; font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .7px;
      color: var(--text-pale);
      padding: 4px 0 8px;
    }
    .cal-days-grid {
      display: grid; grid-template-columns: repeat(7, 1fr);
      gap: 2px;
    }
    .cal-day-cell {
      aspect-ratio: 1;
      display: flex; flex-direction: column;
      align-items: center; justify-content: flex-start;
      padding: 4px 2px;
      border-radius: 8px;
      cursor: pointer;
      transition: var(--transition);
      position: relative;
    }
    .cal-day-cell.empty { pointer-events: none; }
    .cal-day-cell:not(.empty):hover { background: var(--surface); }
    .cal-day-cell.is-today { background: var(--gold-pale); }
    .cal-day-cell.is-today .cal-day-number { color: var(--gold); font-weight: 900; }
    .cal-day-cell.selected { background: var(--navy) !important; }
    .cal-day-cell.selected .cal-day-number { color: var(--white) !important; font-weight: 700; }
    .cal-day-number {
      font-size: 12px; font-weight: 500;
      color: var(--text-mid);
      line-height: 1.4;
    }
    .cal-event-dots {
      display: flex; gap: 2px; align-items: center;
      margin-top: 2px;
      flex-wrap: wrap; justify-content: center;
    }
    .cal-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .dot-future  { background: #3B82F6; }
    .dot-present { background: var(--gold); }
    .dot-past    { background: var(--text-pale); }

    /* Day panel inside calendar */
    .cal-day-panel {
      border-top: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height .35s cubic-bezier(.4,0,.2,1);
    }
    .cal-day-panel.open { max-height: 400px; }
    .cal-day-panel-inner { padding: 14px; }
    .cal-day-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 10px;
    }
    .cal-day-panel-title { font-size: 13px; font-weight: 700; color: var(--navy); }
    .cal-day-panel-close {
      border: none; background: var(--surface);
      width: 24px; height: 24px;
      border-radius: 6px; cursor: pointer;
      font-size: 12px; color: var(--text-soft);
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .cal-day-panel-close:hover { background: var(--navy); color: var(--white); }
    .cal-day-events-list { display: flex; flex-direction: column; gap: 6px; max-height: 280px; overflow-y: auto; }
    .cal-day-event-item {
      padding: 10px 12px;
      background: var(--surface);
      border-radius: 8px;
      border-left: 3px solid var(--navy);
      cursor: pointer;
      transition: var(--transition);
      text-decoration: none;
      display: block;
    }
    .cal-day-event-item:hover { background: var(--surface2); transform: translateX(2px); }
    .cal-day-event-name { font-size: 12px; font-weight: 700; color: var(--text-dark); margin-bottom: 3px; display: block; }
    .cal-day-event-meta { font-size: 11px; color: var(--text-soft); }

    /* Calendar view section */
    .calendar-section { display: none; animation: fadeIn 0.3s both; }
    .calendar-section.show { display: block; }
    .big-calendar-wrap {
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .big-cal-header {
      background: var(--navy);
      padding: 18px 22px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .big-cal-month {
      font-family: 'Sora', sans-serif;
      font-size: 18px; font-weight: 800;
      color: var(--white);
    }
    .big-cal-body { padding: 16px; }
    .big-cal-day-headers {
      display: grid; grid-template-columns: repeat(7, 1fr);
      margin-bottom: 6px;
    }
    .big-cal-day-header-cell {
      text-align: center;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .7px;
      color: var(--text-pale);
      padding: 6px 0 10px;
    }
    .big-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
    .big-cal-day {
      min-height: 72px;
      padding: 6px 6px;
      border-radius: 10px;
      cursor: pointer;
      transition: var(--transition);
      position: relative;
    }
    .big-cal-day.empty { pointer-events: none; }
    .big-cal-day:not(.empty):hover { background: var(--surface); }
    .big-cal-day.is-today { background: var(--gold-pale); }
    .big-cal-day.is-today .big-cal-day-num { color: var(--gold); font-weight: 900; }
    .big-cal-day.selected { background: var(--navy) !important; }
    .big-cal-day.selected .big-cal-day-num { color: var(--white) !important; }
    .big-cal-day-num { font-size: 13px; font-weight: 600; color: var(--text-mid); margin-bottom: 4px; }
    .big-cal-dots { display: flex; gap: 2px; flex-wrap: wrap; }
    .big-cal-body-panel { display: flex; }
    .big-cal-main { flex: 1; }
    .big-cal-side-panel {
      width: 0;
      overflow: hidden;
      transition: width .3s ease;
      border-left: 1px solid var(--border);
    }
    .big-cal-side-panel.open { width: 280px; min-width: 280px; }
    .big-cal-side-inner { padding: 16px; width: 280px; }
    .big-cal-side-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 12px;
    }
    .big-cal-side-title { font-size: 13px; font-weight: 700; color: var(--navy); }
    .big-cal-side-close {
      border: none; background: var(--surface);
      width: 26px; height: 26px; border-radius: 6px;
      cursor: pointer; font-size: 12px; color: var(--text-soft);
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .big-cal-side-close:hover { background: var(--navy); color: var(--white); }
    .big-cal-side-events { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; max-height: 360px; }

    /* ── DETAIL MODAL ── */
    .detail-modal-backdrop {
      position: fixed; inset: 0; z-index: 600;
      background: rgba(0,0,0,0);
      backdrop-filter: blur(0px);
      pointer-events: none;
      transition: background .3s, backdrop-filter .3s;
      display: flex; align-items: flex-end; justify-content: center;
    }
    .detail-modal-backdrop.open {
      background: rgba(11,17,30,.6);
      backdrop-filter: blur(4px);
      pointer-events: all;
    }
    .detail-modal-sheet {
      width: 100%; max-width: 700px;
      background: var(--white);
      border-radius: 24px 24px 0 0;
      padding: 32px 36px 40px;
      position: relative;
      transform: translateY(100%);
      transition: transform .38s cubic-bezier(.34,1.1,.64,1);
      box-shadow: 0 -20px 60px rgba(0,0,0,.18);
      max-height: 90vh; overflow-y: auto;
    }
    .detail-modal-backdrop.open .detail-modal-sheet { transform: translateY(0); }
    .detail-drag-handle {
      width: 40px; height: 4px;
      background: var(--border);
      border-radius: 4px;
      margin: 0 auto 20px;
    }
    .detail-close-btn {
      position: absolute; top: 20px; right: 20px;
      width: 34px; height: 34px;
      border: 1.5px solid var(--border);
      background: var(--surface);
      border-radius: 50%;
      color: var(--text-soft); cursor: pointer;
      font-size: 13px;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .detail-close-btn:hover { background: var(--navy); color: var(--white); border-color: var(--navy); }
    .detail-badge {
      display: inline-flex; align-items: center;
      font-size: 10px; font-weight: 800;
      letter-spacing: 1px; text-transform: uppercase;
      padding: 4px 11px; border-radius: 20px;
      margin-bottom: 10px;
    }
    .detail-title {
      font-family: 'Sora', sans-serif;
      font-size: 24px; font-weight: 800;
      color: var(--text-dark); line-height: 1.25;
      margin-bottom: 4px;
    }
    .detail-dept-label { font-size: 14px; color: var(--text-soft); font-weight: 500; }
    .detail-meta-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
      padding: 18px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      margin: 16px 0;
    }
    .dm { display: flex; align-items: flex-start; gap: 10px; }
    .dm-icon { font-size: 13px; color: var(--gold); margin-top: 3px; width: 16px; flex-shrink: 0; }
    .dm-label { font-size: 10px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--text-pale); margin-bottom: 2px; }
    .dm-value { font-size: 13px; font-weight: 600; color: var(--text-dark); }
    .detail-desc-label {
      font-size: 11px; font-weight: 700; letter-spacing: .8px;
      text-transform: uppercase; color: var(--text-soft);
      display: flex; align-items: center; gap: 6px;
      margin-bottom: 8px;
    }
    .detail-desc-text { font-size: 14px; color: var(--text-mid); line-height: 1.72; }
    .detail-actions {
      display: flex; gap: 10px; margin-top: 24px;
      padding-top: 20px; border-top: 1px solid var(--border);
    }
    .detail-primary-btn {
      flex: 1;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px;
      background: var(--navy); color: var(--white);
      border: none; border-radius: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 700;
      cursor: pointer; transition: var(--transition);
      text-decoration: none;
    }
    .detail-primary-btn:hover { background: var(--navy-mid); }
    .detail-edit-btn-sm {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 20px;
      border: 1.5px solid var(--border);
      background: transparent;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 600;
      color: var(--text-mid);
      border-radius: 10px;
      cursor: pointer; transition: var(--transition);
    }
    .detail-edit-btn-sm:hover { border-color: var(--gold); color: var(--gold); }

    /* ── ADD/EDIT MODAL ── */
    .form-modal-backdrop {
      position: fixed; inset: 0; z-index: 700;
      background: rgba(11,17,30,.0);
      backdrop-filter: blur(0px);
      pointer-events: none;
      transition: background .25s, backdrop-filter .25s;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .form-modal-backdrop.open {
      background: rgba(11,17,30,.65);
      backdrop-filter: blur(5px);
      pointer-events: all;
    }
    .form-modal-box {
      background: var(--white);
      border-radius: 20px;
      width: 100%; max-width: 640px;
      max-height: 92vh; overflow-y: auto;
      transform: translateY(24px) scale(.96);
      opacity: 0;
      transition: transform .32s cubic-bezier(.34,1.3,.64,1), opacity .25s;
      box-shadow: var(--shadow-lg);
    }
    .form-modal-backdrop.open .form-modal-box { transform: translateY(0) scale(1); opacity: 1; }
    .form-modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 20px 24px 18px;
      border-bottom: 1px solid var(--border);
      position: sticky; top: 0; background: var(--white); z-index: 1;
    }
    .form-modal-title-group { display: flex; align-items: center; gap: 12px; }
    .form-modal-icon {
      width: 36px; height: 36px;
      background: var(--navy); border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: var(--gold); font-size: 16px;
    }
    .form-modal-title { font-size: 17px; font-weight: 700; color: var(--text-dark); }
    .form-modal-close {
      width: 32px; height: 32px;
      border: 1.5px solid var(--border);
      background: var(--surface);
      border-radius: 50%; cursor: pointer;
      color: var(--text-soft); font-size: 12px;
      display: flex; align-items: center; justify-content: center;
      transition: var(--transition);
    }
    .form-modal-close:hover { background: var(--navy); color: var(--white); border-color: var(--navy); }

    .form-modal-body { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 12px; font-weight: 700; color: var(--text-mid); letter-spacing: .3px; }
    .form-req { color: var(--gold); }
    .form-input,
    .form-textarea,
    .form-select {
      padding: 10px 13px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; color: var(--text-dark);
      background: var(--white);
      outline: none; width: 100%;
      transition: var(--transition);
    }
    .form-input:focus, .form-textarea:focus, .form-select:focus {
      border-color: var(--navy);
      box-shadow: 0 0 0 3px rgba(28,43,74,.07);
    }
    .form-textarea { resize: vertical; }
    .form-select { appearance: none; cursor: pointer; }
    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 14px; }
    .select-field-wrap { position: relative; }
    .select-field-arrow {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      font-size: 10px; color: var(--text-pale); pointer-events: none;
    }
    .form-modal-footer {
      display: flex; gap: 10px; justify-content: flex-end;
      padding: 14px 24px;
      border-top: 1px solid var(--border);
      position: sticky; bottom: 0; background: var(--white);
    }
    .btn-ghost-form {
      padding: 9px 18px;
      border: 1.5px solid var(--border);
      background: transparent;
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 600;
      color: var(--text-mid);
      cursor: pointer; transition: var(--transition);
    }
    .btn-ghost-form:hover { border-color: var(--text-mid); }
    .btn-primary-form {
      padding: 9px 22px;
      background: var(--navy); color: var(--white);
      border: none; border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 700;
      cursor: pointer; transition: var(--transition);
      display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-primary-form:hover { background: var(--navy-mid); transform: scale(1.01); }

    /* ── TOAST ── */
    .toast-notification {
      position: fixed; bottom: 24px; right: 24px; z-index: 900;
      display: flex; align-items: center; gap: 10px;
      padding: 13px 18px;
      background: var(--navy);
      color: var(--white);
      border-radius: 12px;
      font-family: 'Inter', sans-serif;
      font-size: 13px; font-weight: 600;
      box-shadow: 0 8px 32px rgba(0,0,0,.25);
      transform: translateY(80px) scale(.94);
      opacity: 0;
      transition: transform .32s cubic-bezier(.34,1.3,.64,1), opacity .25s;
      pointer-events: none;
      border-left: 3px solid var(--gold);
    }
    .toast-notification.show {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    .toast-icon { color: var(--gold); font-size: 16px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 1100px) {
      .events-grid { grid-template-columns: repeat(2, 1fr); }
      .calendar-column { width: 290px; }
    }
    @media (max-width: 900px) {
      .content-layout { flex-direction: column; }
      .calendar-column { width: 100%; position: static; max-height: none; }
      .events-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .events-grid { grid-template-columns: 1fr; }
      .navbar-inner { padding: 0 16px; }
      .nav-university-name { font-size: 15px; }
      .hero-outer { padding: 16px 16px 0; }
      .hero-content { padding: 24px 28px; }
      .hero-heading { font-size: 26px; }
      .page-body { padding: 0 16px 40px; }
      .detail-modal-sheet { padding: 24px 20px 32px; }
    }
  </style>
</head>
<body>

